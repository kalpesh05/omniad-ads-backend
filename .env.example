# =============================================================================
# omniad-ads-backend Environment Variables
# Values below are from Stackby_API .env.development for reuse when running together.
# config/env.js maps Stackby variable names (DB_USERNAME, FACEBOOK_CLIENT_*, etc.)
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=express_auth_db
DB_PORT=3306

# Database Fallbacks (used by Railway, Render, etc.)
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=your_password
# MYSQLDATABASE=express_auth_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Security
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis Configuration (Optional - for caching and session management)
REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=info

# API Configuration
API_BASE_URL=http://localhost:3000/api

# Frontend URL (for Stripe redirects, etc.)
FRONTEND_URL=https://harmonious-dieffenbachia-6aecb9.netlify.app

# Email Configuration (for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload (for future features)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Google Ads / YouTube / Analytics
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/api/ads-auth/callback/google
GOOGLE_ANALYTIC_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/api/ads-auth/callback/google-analytics

GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
YOUTUBE_API_KEY=your-youtube-api-key

# Facebook / Meta / Instagram
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms

# TikTok
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms

# Microsoft Ads
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms
MICROSOFT_DEVELOPER_TOKEN=your-microsoft-developer-token

# Amazon Ads
AMAZON_CLIENT_ID=your-amazon-client-id
AMAZON_CLIENT_SECRET=your-amazon-client-secret
AMAZON_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms


# Twitter / X
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms


# Shopify
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms


# HubSpot
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=https://harmonious-dieffenbachia-6aecb9.netlify.app/dashboard/platforms

# Slack (from Stackby)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://dev9.stackby.com/integrations/slack/authorize/callback

# AI Services (Optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret


